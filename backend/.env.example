# VibeYetu backend settings.
# This file is a TEMPLATE and is safe to commit. It must never hold real secrets.
# To use it: copy it to a file named .env (in this same folder) and fill in the real values.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Frontend address allowed to call this API (CORS) ---
# Vite's default dev address. For several addresses, separate them with commas.
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vibeyetu
DB_USER=postgres
DB_PASSWORD=put_your_postgres_password_here

# --- Login tokens (JWT) ---
# Replace with your own long random text (at least 32 characters). Never share it.
# To make one, run in the terminal:  node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_text_at_least_32_characters
# How long a login lasts: 7d = 7 days, 12h = 12 hours.
JWT_EXPIRES_IN=7d

# --- Key that locks private seller details (national ID, KRA PIN) in the database ---
# Make one by running in the terminal:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste the 64 characters it prints. KEEP A SAFE COPY OUTSIDE THE PROJECT: if it is lost, those details cannot be read again.
DATA_ENCRYPTION_KEY=put_64_hex_characters_here

# --- Africa's Talking (SMS codes). Used only when NODE_ENV=production ---
# In development the code is printed in the terminal instead.
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key

# --- Used in later batches (leave these placeholders for now) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Help assistant (optional) ---
# Get a free key at https://aistudio.google.com (no card needed), then replace the placeholder.
# Leave it as is and the assistant answers from built-in answers instead.
AI_API_KEY=your_google_ai_studio_key
AI_MODEL=gemini-flash-latest
