# VibeYetu backend settings.
# This file is a TEMPLATE and is safe to commit. It must never hold real secrets.
# To use it: copy it to a file named .env (in this same folder) and fill in the real values.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Frontend address allowed to call this API (CORS) ---
# Vite's default dev address. For several addresses, separate them with commas.
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL (local) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=vibeyetu
DB_USER=postgres
DB_PASSWORD=put_your_postgres_password_here

# --- Used in later batches (leave these placeholders for now) ---
JWT_SECRET=change_me_to_a_long_random_text
AT_USERNAME=sandbox
AT_API_KEY=your_africas_talking_api_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
